# maniFasta configuration
#
# Review the run settings below before each build. Most users can leave the
# remaining settings unchanged.

################################################################################
# Run settings
################################################################################

# Root directory of this maniFasta copy.
mainDIR="/XXX/YYY/ZZZ/maniFasta"

# Standard project paths. These are defined here so later settings can use them.
setupDIR="${mainDIR}/00.setup"
scriptsDIR="${mainDIR}/01.scripts"
source_registry="${setupDIR}/000.maniFasta.source_registry.tsv"

# Output directories are named YYYYMMDD_HHMMSS_${run_label}.
run_label="maniFastaDB_XYZ"

# Prefix assigned to every protein identifier in the output FASTA.
db_prefix="maniFastaDB"

# Slurm scheduler settings. Fill these in when using the Slurm submission
# wrapper; they are not needed for a direct run.
cluster=""
partition=""
qos=""

################################################################################
# Optional source settings
################################################################################

# HOMD taxonomy table. Leave empty to retrieve it from HOMD, or provide a local
# file to pin the taxonomy input.
# Example:
# homd_tax_local_file="${mainDIR}/99.prepackaged_inputs/MOD-IV.HOMD_taxon_table2026-08-02_1785700972.txt"
homd_tax_local_file="${mainDIR}/99.prepackaged_inputs/MOD-IV.HOMD_taxon_table2026-08-02_1785700972.txt"

# Unversioned HOMD PROKKA root. Pin a release for each HOMD source in the source
# registry with genomic_refseq_version (for example, V11.03).
homd_prokka_base_url="https://www.homd.org/ftp/genomes/PROKKA"

################################################################################
# Output and reporting
################################################################################

# Add ranked NCBI taxonomy to a copy of the final manifest.
add_lineage="true"
lineage_cache_file="${mainDIR}/taxid_lineage_cache.tsv"

# Create taxonomy sunbursts. SVG and interactive HTML are produced by default;
# PNG additionally requires matplotlib.
plot_taxonomy="true"
taxonomy_plot_png="false"

# Create a draft methods summary from the completed build artifacts.
write_db_summary="true"

################################################################################
# Project directories
################################################################################

# runBuild_db.sh supplies RUN_REFDIR and RUN_TMPDIR after it creates the
# timestamped run directory. These fallbacks keep the config usable when it is
# sourced outside a build.
refDIR="${RUN_REFDIR:-${mainDIR}/run_data}"
tmpDIR="${RUN_TMPDIR:-${mainDIR}/tmp}"
TMPDIR="${tmpDIR}"

# Finished run directories and Slurm logs are written below mainDIR by default.
dbRootDIR="${mainDIR}"
logDIR="${mainDIR}"

# Run-scoped working-directory names.
run_reference_data_subdir="run_data"
run_tmp_subdir="tmp"

################################################################################
# Slurm resources
################################################################################

build_JobName="maniFasta_build"
build_Nodes=1
build_cpuspertask=4
build_mem="32G"
build_Time="3:00:00"

################################################################################
# NCBI credentials and request pacing
################################################################################

# Credentials are populated from 000.maniFasta.local.env.
ncbi_email="${NCBI_EMAIL:-}"
ncbi_api_key="${NCBI_API_KEY:-}"

# Applied to supported NCBI-backed fetches. Smaller batches and longer sleeps
# reduce request pressure; larger batches and shorter sleeps may be faster.
ncbi_batch_size=200
ncbi_sleep_no_key="0.4"
ncbi_sleep_api_key="0.11"

################################################################################
# Validation and build behavior
################################################################################

# Fail when an enabled registry row points to a missing input file.
fail_on_missing_source_file="true"

# Base directory used for registry paths that omit source_dir.
registry_path_base="${setupDIR}"

# Skip and report accessions that a remote source does not return. Set to false
# to stop the build when any requested accession is missing.
allow_missing_accessions="true"

# Reserved configuration controls. They are retained for configuration
# compatibility, but the current scripts do not read them; changing these
# values does not alter a build.
fail_on_missing_metadata="true"
fail_on_unmatched_metadata="false"
allow_relative_registry_paths="true"
enrich_missing_taxonomy="true"
write_original_headers="true"
write_source_composition="true"

################################################################################
# Run-scoped staging paths
################################################################################

user_fasta_file="${refDIR}/user_supplied/user_supplied_combined.fasta"
user_metadata_file="${refDIR}/user_supplied/user_supplied_metadata.tsv"
proteomes_dir="${refDIR}/user_specified_proteomes"
Species_resolved="${proteomes_dir}/species_resolved.tsv"
proteomes_manifest="${proteomes_dir}/proteomes_manifest.tsv"

# Final output paths are assigned by runBuild_db.sh after it creates RUN_DIR.
db_fasta_output=""
db_map_output=""
